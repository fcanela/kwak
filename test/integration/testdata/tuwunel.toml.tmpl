# Generated by ittest from test/integration/testdata/tuwunel.toml.tmpl. Modelled on the tuwunel
# role's tuwunel.toml.j2. Every key exists in the v1.9.4 example config, so the server refuses to
# start on a misspelt key (error_on_unknown_config_opts). Backups and well_known are left out: the
# container is read-only, has no backup mount, and nothing here needs discovery.

[global]
server_name = "{{.ServerName}}"
database_path = "/var/lib/tuwunel"
address = "0.0.0.0"
port = 8008

error_on_unknown_config_opts = true

allow_federation = false
federate_created_rooms = false
federate_admin_room = false
trusted_servers = []

allow_registration = true
registration_token_file = "{{.RegistrationTokenFile}}"
allow_guest_registration = false
grant_admin_to_first_user = true

require_auth_for_profile_requests = true
allow_public_room_directory_without_auth = false
lockdown_public_room_directory = true
allow_legacy_media = false
allow_encryption = true

max_request_size = "50 MiB"
db_cache_capacity_mb = 32

# The same two settings as the Matrix host (spec 3.8): a request without X-Forwarded-For fails.
ip_source = "rightmost_x_forwarded_for"
ip_source_trusted_subnets = []

appservice_dir = "{{.AppserviceDir}}"

log = "info"
log_colors = false
